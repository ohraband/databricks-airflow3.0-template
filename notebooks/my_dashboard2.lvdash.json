      "displayName": "User Answer Scores and Reputation Summary Dataset",
      "queryLines": [
        "SELECT avg(score) as average_answer_score, Reputation, Id as UserId\n",
        "from data_platform_tutorial.default.marts_posts_user\n",
        "WHERE PostType=\"Answer\"\n",
        "group by Id, Reputation\n"
      ]
    }
